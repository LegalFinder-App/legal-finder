# Copy to .env (gitignored). All EXPO_PUBLIC_* values are compiled into the app and are PUBLIC —
# they're the same publishable keys the website ships to every browser. Never put a secret here.

# Clerk production publishable key (same as the web's VITE_CLERK_PUBLISHABLE_KEY)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...

# Supabase (same as the web's VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY)
EXPO_PUBLIC_SUPABASE_URL=https://vdwgohwlawsykvbynasp.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Web app that serves /api/mobile/* — must be the canonical www host.
EXPO_PUBLIC_API_URL=https://www.legalfinder.co

# Optional: video hearing room base (defaults to Jitsi, same as the web)
# EXPO_PUBLIC_LIVE_TRIAL_ROOM_BASE_URL=https://meet.jit.si

# The EAS project id is not set here: it is a constant in app.config.ts.

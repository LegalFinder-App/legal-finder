# Application runtime (browser)
VITE_APP_NAME=LegalFinder
VITE_APP_URL=http://localhost:3000

# Supabase — required for the app
# Browser bundle reads VITE_* values; SSR/server code also accepts non-prefixed names.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only — never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ImageKit (Dashboard > Developer options)
# The URL endpoint and public key may be used by the browser. Never expose the private key.
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_UPLOAD_FOLDER=/legalfinder

# Optional: browser push (public key in client; private key on server when push fanout is enabled)
# Generate a VAPID key pair with: npx web-push generate-vapid-keys
VITE_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
# Optional: VAPID "subject" required by the push protocol (a mailto: address or your site URL).
# Falls back to VITE_APP_URL, then a hardcoded default, if unset.
WEB_PUSH_SUBJECT=

# Required for the compliance-check cron (src/routes/api.cron.compliance-check.tsx) to accept
# requests — the route rejects everything if this isn't set. Vercel sends it automatically as
# `Authorization: Bearer $CRON_SECRET` for the scheduled job in vercel.json once this is
# configured in the project's environment variables.
CRON_SECRET=

# AI assistant (server-side only — never expose to the client bundle)
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Pesapal (server-side only). Sandbox credentials: https://developer.pesapal.com/
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_ENV=sandbox
# Optional: set after the first IPN registration to skip re-registering on every payment.
PESAPAL_IPN_ID=

# Flutterwave (server-side only) — pays a lawyer out automatically the instant their client's
# Pesapal payment is confirmed. Sandbox credentials: https://developer.flutterwave.com/
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENV=sandbox
# The secret hash configured on the Flutterwave dashboard's webhook settings.
FLUTTERWAVE_WEBHOOK_HASH=

# Optional integrations
VITE_LIVE_TRIAL_ROOM_BASE_URL=

# Optional: apply migrations via scripts/apply-migrations.mjs
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_ACCESS_TOKEN=

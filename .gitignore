# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local
.env
.env.*
!.env.example
supabase-token.txt
*.token
.vercel

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Mobile (Capacitor) — native projects are committed, their build output/machine-specific
# config is not
platforms/mobile/android/**/build/
platforms/mobile/android/.gradle/
platforms/mobile/android/local.properties
# Release signing key — never commit. See platforms/mobile/android/keystore/README.md.
platforms/mobile/android/keystore/*.keystore
platforms/mobile/android/keystore/*.jks
platforms/mobile/android/keystore.properties
platforms/mobile/android/**/*.iml
platforms/mobile/ios/App/Pods/
platforms/mobile/ios/App/**/DerivedData/

# Desktop (Electron) — packaged build output, and a local pre-extracted Electron binary used to
# work around a Windows-specific electron-builder rename race (see platforms/desktop/windows/README.md)
platforms/desktop/release/
.electron-dist-*/

# A per-build copy of the files Play Console takes, gathered for uploading (the bundle is ~86 MB;
# the graphics and screenshots in it are tracked where they live).
store-listing/play-upload-*/
# The App Store preview video (scripts/store-previews.mjs makes it again).
store-listing/previews/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.env*

  "radius": {
    "base": "0.75rem",
    "sm": "base - 4px",
    "md": "base - 2px",
    "lg": "base",
    "xl": "base + 4px",
    "2xl": "base + 8px",
    "3xl": "base + 12px",
    "4xl": "base + 20px",
    "full": "9999px"
  },
  "spacing": {
    "unit": "4px",
    "scale": [0, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96]
  },
  "font": {
    "sans": "Plus Jakarta Sans (variable 200–800)",
    "serif": "Fraunces italic (accent words only)",
    "mono": "IBM Plex Mono 400/500"
  },
  "type": {
    "display": "clamp(2.5rem, 1.75rem + 3.75vw, 4.75rem)",
    "display--line-height": "1.02",
    "display--letter-spacing": "-0.034em",
    "h1": "clamp(2.125rem, 1.6rem + 2.4vw, 3.5rem)",
    "h1--line-height": "1.06",
    "h1--letter-spacing": "-0.035em",
    "h2": "clamp(1.75rem, 1.4rem + 1.6vw, 2.75rem)",
    "h2--line-height": "1.1",
    "h2--letter-spacing": "-0.03em",
    "h3": "clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem)",
    "h3--line-height": "1.2",
    "h3--letter-spacing": "-0.02em",
    "h4": "clamp(1.125rem, 1.05rem + 0.35vw, 1.3125rem)",
    "h4--line-height": "1.3",
    "h4--letter-spacing": "-0.015em",
    "lead": "clamp(1.0625rem, 1rem + 0.3vw, 1.25rem)",
    "lead--line-height": "1.6",
    "caption": "0.75rem",
    "caption--line-height": "1.4",
    "overline": "0.6875rem",
    "overline--line-height": "1.2",
    "overline--letter-spacing": "0.14em"
  },
  "motion": {
    "duration": {
      "fast": "150ms",
      "base": "250ms",
      "slow": "400ms"
    },
    "easing": {
      "out-expo": "cubic-bezier(0.16, 1, 0.3, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "standard": "cubic-bezier(0.2, 0, 0, 1)"
    }
  },
  "shadow": {
    "light": {
      "xs": "0 1px 2px oklch(0.25 0.04 262 / 0.05)",
      "plate": "0 1px 2px oklch(0.25 0.04 262 / 0.05), 0 8px 24px -12px oklch(0.25 0.04 262 / 0.14)",
      "raised": "0 2px 4px oklch(0.25 0.04 262 / 0.05), 0 24px 48px -20px oklch(0.25 0.04 262 / 0.28)",
      "float": "0 4px 8px oklch(0.2 0.04 262 / 0.08), 0 32px 64px -24px oklch(0.2 0.04 262 / 0.42)",
      "glow": "0 0 0 1px oklch(0.78 0.115 80 / 0.4), 0 8px 32px -6px oklch(0.78 0.115 80 / 0.45)"
    },
    "dark": {
      "xs": "0 1px 2px oklch(0 0 0 / 0.3)",
      "plate": "0 1px 2px oklch(0 0 0 / 0.35), 0 8px 24px -12px oklch(0 0 0 / 0.6)",
      "raised": "0 2px 4px oklch(0 0 0 / 0.35), 0 24px 48px -20px oklch(0 0 0 / 0.75)",

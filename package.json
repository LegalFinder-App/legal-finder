{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "prebuild": "node scripts/verify-vercel-env.mjs",
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "db:push": "supabase db push",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "db:reset": "supabase db reset",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "mobile:icons": "cd platforms/mobile && npx capacitor-assets generate --android --ios --iconBackgroundColor '#1a2338' --iconBackgroundColorDark '#1a2338' --splashBackgroundColor '#1a2338' --splashBackgroundColorDark '#1a2338'",
    "mobile:sync": "cd platforms/mobile && npx cap sync",
    "mobile:android:open": "cd platforms/mobile && npx cap open android",
    "mobile:android:build": "node scripts/run-gradle.mjs assembleDebug",
    "mobile:android:bundle": "node scripts/run-gradle.mjs bundleRelease",
    "mobile:ios:open": "cd platforms/mobile && npx cap open ios",
    "mobile:ios:sync": "cd platforms/mobile && npx cap sync ios",
    "desktop:dev": "electron platforms/desktop/electron/main.js",
    "desktop:dist:win": "electron-builder --config platforms/desktop/electron-builder.yml --win",
    "desktop:dist:linux": "electron-builder --config platforms/desktop/electron-builder.yml --linux",
    "desktop:dist:mac": "electron-builder --config platforms/desktop/electron-builder.yml --mac",
    "desktop:dist:win:eperm-fix": "electron-builder --config platforms/desktop/electron-builder.yml --win -c.electronDist=.electron-dist-win32-x64",
    "desktop:dist:linux:eperm-fix": "electron-builder --config platforms/desktop/electron-builder.yml --linux -c.electronDist=.electron-dist-linux-x64"
  },
